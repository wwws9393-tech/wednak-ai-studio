rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType in ['مدير', 'مدير Admin'];
    }

    function immutableBookingIdentity() {
      return request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.targetOwnerId == resource.data.targetOwnerId
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.itemType == resource.data.itemType
        && request.resource.data.hallId == resource.data.hallId
        && request.resource.data.serviceProviderId == resource.data.serviceProviderId;
    }

    function validUserRole(role) {
      return role in ['زبون', 'صاحب قاعة', 'مزود خدمة'];
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.id == userId
        && validUserRole(request.resource.data.accountType);
      allow update: if isSelf(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.accountType == resource.data.accountType;
      allow delete: if isSelf(userId) || isAdmin();

      match /favorites/{favoriteId} {
        allow read, create, update, delete: if isSelf(userId);
      }
    }

    match /favorites/{favoriteId} {
      allow read, write: if false;
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.requesterId != request.resource.data.targetOwnerId
        && request.resource.data.status in ['قيد المراجعة', 'pending'];

      allow read: if signedIn()
        && (resource.data.requesterId == request.auth.uid
          || resource.data.targetOwnerId == request.auth.uid
          || isAdmin());

      allow update: if signedIn() && immutableBookingIdentity() && (
        (resource.data.requesterId == request.auth.uid
          && request.resource.data.status in ['ملغي', 'cancelled'])
        ||
        (resource.data.targetOwnerId == request.auth.uid
          && request.resource.data.status in ['مقبول', 'accepted', 'مرفوض', 'rejected', 'ملغي', 'cancelled', 'completed'])
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Atomic 30-minute reservation locks. Only the booking's target owner can create them;
    // either booking party may delete its own locks during cancellation.
    match /bookingLocks/{lockId} {
      allow read: if signedIn()
        && (resource.data.requesterId == request.auth.uid
          || resource.data.targetOwnerId == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && request.resource.data.targetOwnerId == request.auth.uid
        && request.resource.data.requesterId != request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.requesterId == request.auth.uid
          || resource.data.targetOwnerId == request.auth.uid
          || isAdmin());
    }

    match /halls/{hallId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /serviceProviders/{providerId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /complaints/{complaintId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
