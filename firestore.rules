rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType in ['مدير', 'مدير Admin'];
    }

    function validUserRole(role) {
      return role in ['زبون', 'صاحب قاعة', 'مزود خدمة'];
    }

    function pendingStatus(status) {
      return status in ['قيد المراجعة', 'pending'];
    }

    function acceptedStatus(status) {
      return status in ['مقبول', 'accepted'];
    }

    function cancelledStatus(status) {
      return status in ['ملغي', 'cancelled'];
    }

    function rejectedStatus(status) {
      return status in ['مرفوض', 'rejected'];
    }

    function canManageAvailability(bookingId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/bookings/$(bookingId))
        && (
          getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.requesterId == request.auth.uid
          || getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.targetOwnerId == request.auth.uid
          || isAdmin()
        );
    }

    function immutableBookingIdentity() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'updatedAt', 'cancelledAt', 'cancelledById', 'cancelledByRole',
        'cancelledByName', 'cancellationReason', 'paymentStatus', 'paymentMethod',
        'paymentReference', 'paidAt', 'rejectionReason'
      ]);
    }

    function requesterCanTransition() {
      return resource.data.requesterId == request.auth.uid
        && (pendingStatus(resource.data.status) || acceptedStatus(resource.data.status))
        && cancelledStatus(request.resource.data.status);
    }

    function targetCanTransition() {
      return resource.data.targetOwnerId == request.auth.uid
        && (
          (pendingStatus(resource.data.status)
            && (
              rejectedStatus(request.resource.data.status)
              || (acceptedStatus(request.resource.data.status)
                && (!('startsAt' in resource.data) || resource.data.startsAt > request.time))
            ))
          ||
          (acceptedStatus(resource.data.status)
            && (cancelledStatus(request.resource.data.status) || request.resource.data.status == 'completed'))
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId)
        && request.resource.data.id == userId
        && validUserRole(request.resource.data.accountType)
        && !exists(/databases/$(database)/documents/deletedUsers/$(userId));
      allow update: if isAdmin() || (isSelf(userId)
        && request.resource.data.id == userId
        && request.resource.data.accountType == resource.data.accountType
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlocked','blockedAt','blockedBy','blockReason']));
      allow delete: if isSelf(userId) || isAdmin();

      match /favorites/{favoriteId} {
        allow read, create, update, delete: if isSelf(userId) || isAdmin();
      }

      match /notificationState/{stateId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if isSelf(userId);
      }
    }

    match /deletedUsers/{userId} {
      allow read, write: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read, write: if false;
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.requesterId != request.resource.data.targetOwnerId
        && pendingStatus(request.resource.data.status)
        && request.resource.data.startsAt is timestamp
        && request.resource.data.startsAt > request.time;

      allow read: if signedIn()
        && (resource.data.requesterId == request.auth.uid
          || resource.data.targetOwnerId == request.auth.uid
          || isAdmin());

      allow update: if signedIn()
        && immutableBookingIdentity()
        && (requesterCanTransition() || targetCanTransition() || isAdmin());

      allow delete: if isAdmin();
    }

    // Privacy-safe public availability. No customer name/phone/requester ID is stored here.
    match /bookingLocks/{lockId} {
      allow read: if true;
      allow create: if signedIn()
        && (request.resource.data.targetOwnerId == request.auth.uid || isAdmin())
        && request.resource.data.keys().hasOnly([
          'bookingId', 'itemId', 'date', 'minute', 'targetOwnerId', 'createdAt'
        ]);
      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.targetOwnerId == request.auth.uid
        || isAdmin()
        || (
          exists(/databases/$(database)/documents/bookings/$(resource.data.bookingId))
          && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.requesterId == request.auth.uid
        )
      );
    }

    // Public pending-time indicators contain no customer identity or contact details.
    // They inform users without reserving the time; only bookingLocks block a slot.
    match /bookingAvailability/{bookingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'bookingId', 'itemId', 'date', 'startMinute', 'endMinute', 'status', 'requesterKey', 'createdAt'
        ])
        && request.resource.data.bookingId == bookingId
        && pendingStatus(request.resource.data.status)
        && request.resource.data.startMinute is int
        && request.resource.data.endMinute is int
        && request.resource.data.startMinute >= 0
        && request.resource.data.endMinute > request.resource.data.startMinute
        && request.resource.data.endMinute <= 2880
        && request.resource.data.requesterKey is string
        && existsAfter(/databases/$(database)/documents/bookings/$(bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.requesterId == request.auth.uid
        && pendingStatus(getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status)
        && request.resource.data.itemId == getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.itemId
        && request.resource.data.date == getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.date;
      allow update: if false;
      allow delete: if canManageAvailability(bookingId);
    }

    // One private lock per requester and half-hour segment prevents a single
    // account from creating duplicate or overlapping pending requests.
    match /requesterBookingLocks/{lockId} {
      // Transactions must be able to test a deterministic lock that does not
      // exist yet. Individual gets are allowed to signed-in users, while list
      // queries remain blocked so this private collection cannot be browsed.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'bookingId', 'requesterId', 'targetOwnerId', 'itemId', 'date', 'minute', 'createdAt'
        ])
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.requesterId == request.auth.uid
        && pendingStatus(getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status);
      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.requesterId == request.auth.uid
        || resource.data.targetOwnerId == request.auth.uid
        || isAdmin()
      );
    }

    match /halls/{hallId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /serviceProviders/{providerId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /complaints/{complaintId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
