rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
      
      // User-nested Favorites Collection
      match /favorites/{favoriteId} {
        allow read, write: if true;
      }
    }

    // Root Favorites Collection
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Deterministic slot locks prevent two simultaneous requests from
    // reserving the same hall/service, date and period during testing.
    match /bookingSlots/{slotId} {
      allow read, write: if true;
    }

    // Halls Collection
    match /halls/{hallId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
                    && (resource.data.ownerId == request.auth.uid
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownedHallId == hallId)
                    && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
                    && (resource.data.ownerId == request.auth.uid
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownedHallId == hallId);
    }

    // Service Providers Collection
    match /serviceProviders/{providerId} {
      allow read, write: if true;
    }

    // Posts Collection
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Offers Collection
    match /offers/{offerId} {
      allow read, write: if true;
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read, write: if true;
    }
  }
}
